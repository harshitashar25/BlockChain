# Moralis API Configuration
MORALIS_API_KEY=your_moralis_api_key_here

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraud-trail-password

# Kafka Configuration
KAFKA_BROKER=localhost:9092

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=fraud-evidence

# Hyperledger Fabric Configuration (for production)
FABRIC_NETWORK_NAME=test-network
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=fraudchain
FABRIC_PEER_ADDRESS=localhost:7051
FABRIC_ORDERER_ADDRESS=localhost:7050
FABRIC_MSP_ID=Org1MSP
FABRIC_WALLET_PATH=./wallet

# KMS/HSM Configuration (for production signing)
KMS_TYPE=openssl
KMS_KEY_PATH=./keys/private_key.pem
KMS_PUBLIC_KEY_PATH=./keys/public_key.pem

# Server Configuration
PORT=4000
NODE_ENV=development

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
ENCRYPTION_KEY=your_encryption_key_here_32_chars_minimum

# Bank Adapter Mock (for PoC)
